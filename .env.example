# Copy this file to .env and fill in values from Razorpay Dashboard.
# Never put KEY_SECRET or WEBHOOK_SECRET in frontend JavaScript or commit .env.
PORT=3000
APP_BASE_URL=http://localhost:3000
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME
# Price in INR paise (e.g. 49900 = ₹499). Keep server-side; do not trust browser amount.
PRODUCT_NAME=Website Access
PRODUCT_PRICE_PAISE=49900
